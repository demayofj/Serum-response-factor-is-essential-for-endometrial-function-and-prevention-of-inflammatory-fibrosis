## Part IV: Systems analysis of cell-cell communication network
CCobjCtrl <- netAnalysis_computeCentrality(CCobjCtrl, slot.name="netP");
#png("cellchat_outputs/network_view.NOTCH_all_example.png", h=1000, w=1000, res=100);
#netAnalysis_signalingRole_network(CCobjCtrl, signaling=pathways.show, width=18, height=4, font.size=10);
#dev.off();
#png("cellchat_outputs/network_scatter_view.all_example.png", h=1000, w=1000, res=100);
#netAnalysis_signalingRole_scatter(CCobjCtrl);
#dev.off();
#png("cellchat_outputs/network_scatter_view.selected_example.png", h=1000, w=1000, res=100);
#netAnalysis_signalingRole_scatter(CCobjCtrl, signaling=c("NOTCH","SEMA7","CXCL","GAP"));
#dev.off();
png("cellchat_outputs/network_heatmap_view.Ctrl.png", h=800, w=1200, res=100);
ht1 <- netAnalysis_signalingRole_heatmap(CCobjCtrl, pattern="outgoing");
ht2 <- netAnalysis_signalingRole_heatmap(CCobjCtrl, pattern="incoming");
ht1 + ht2;
dev.off();
#png("cellchat_outputs/network_heatmap_view.selected_example.png", h=1000, w=2000, res=100);
#ht1 <- netAnalysis_signalingRole_heatmap(CCobjCtrl, pattern="outgoing", signaling=c("NOTCH","SEMA7","CXCL","GAP"));
#ht2 <- netAnalysis_signalingRole_heatmap(CCobjCtrl, pattern="incoming", signaling=c("NOTCH","SEMA7","CXCL","GAP"));
#ht1 + ht2;
#dev.off();
save.image("Working-CellChatDB-19feb2025-Ctrl-x3.RData");  ## DEV

png("cellchat_outputs/infer_number_of_patterns-outgoing.Ctrl.png", h=500, w=800, res=100);  # choose N at which values (suddenly) drop
selectK(CCobjCtrl, pattern="outgoing");
dev.off();
nPatternsOut <- 4;  ## define based on plots!
png("cellchat_outputs/comm_patterns-outgoing.Ctrl.png", h=1000, w=1000, res=100);
CCobjCtrl <- identifyCommunicationPatterns(CCobjCtrl, pattern="outgoing", k=nPatternsOut);
dev.off();
png("cellchat_outputs/comm_patterns_river-outgoing.Ctrl.png", h=1000, w=1000, res=100);
netAnalysis_river(CCobjCtrl, pattern="outgoing");
dev.off();
png("cellchat_outputs/comm_patterns_dot-outgoing.Ctrl.png", h=1000, w=2000, res=100);
netAnalysis_dot(CCobjCtrl, pattern="outgoing");
dev.off();
png("cellchat_outputs/infer_number_of_patterns-incoming.Ctrl.png", h=500, w=800, res=100);  # choose N at which values (suddenly) drop
selectK(CCobjCtrl, pattern="incoming");
dev.off();
nPatternsIn <- 4;  ## define based on plots!
png("cellchat_outputs/comm_patterns-incoming.Ctrl.png", h=1000, w=1000, res=100);
CCobjCtrl <- identifyCommunicationPatterns(CCobjCtrl, pattern="incoming", k=nPatternsIn);
dev.off();
png("cellchat_outputs/comm_patterns_river-incoming_Ctrl.png", h=1000, w=1000, res=100);
netAnalysis_river(CCobjCtrl, pattern="incoming");
dev.off();
png("cellchat_outputs/comm_patterns_dot-incoming_Ctrl.png", h=1000, w=2000, res=100);
netAnalysis_dot(CCobjCtrl, pattern="incoming");
dev.off();
save.image("Working-CellChatDB-19feb2025-Ctrl-x4.RData");  ## DEV

CCobjCtrl <- computeNetSimilarity(CCobjCtrl, type="functional");
CCobjCtrl <- netEmbedding(CCobjCtrl, type="functional", umap.method="uwot");
CCobjCtrl <- netClustering(CCobjCtrl, type="functional");
png("cellchat_outputs/comm_patterns_typeFunctional.Ctrl.png", h=1000, w=1000, res=100);
netVisual_embedding(CCobjCtrl, type="functional", label.size=3.5);
dev.off();
png("cellchat_outputs/comm_patterns_typeFunctional-zoom.Ctrl.png", h=1000, w=1000, res=100);
netVisual_embeddingZoomIn(CCobjCtrl, type="functional", nCol=2);
dev.off();
CCobjCtrl <- computeNetSimilarity(CCobjCtrl, type="structural");
CCobjCtrl <- netEmbedding(CCobjCtrl, type="structural", umap.method="uwot");
CCobjCtrl <- netClustering(CCobjCtrl, type="structural");
png("cellchat_outputs/comm_patterns_typeStructural.Ctrl.png", h=1000, w=1000, res=100);
netVisual_embedding(CCobjCtrl, type="structural", label.size=3.5);
dev.off()
png("cellchat_outputs/comm_patterns_typeStructural-zoom.Ctrl.png", h=1000, w=1000, res=100);
netVisual_embeddingZoomIn(CCobjCtrl, type="structural", nCol=2);
dev.off();


## cleanup and save working object
rm(nPatternsIn,nPatternsOut,CellChatDB,CellChatDB.use,groupSize,ht1,ht2);
save.image("save_rdata/RM-CellChatDB-Ctrl.19feb2025.RData");

