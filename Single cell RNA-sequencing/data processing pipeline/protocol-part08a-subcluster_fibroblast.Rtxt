### Rename fibroblast subtypes.  Use res=0.15.
res <- 0.15;
CellsChunk <- FindClusters(CellsChunk, resolution=res);
CellsChunk <- RenameIdents(CellsChunk, '0'="FibroblastF2", '1'="FibroblastF2", '4'="FibroblastF3", '5'="FibroblastUnk",
                                       '2'="ProliferatingFibroblastSG2", '3'="ProliferatingFibroblastM");
CellsChunk$FibroblastSubtype <- Idents(CellsChunk);
Idents(CellsChunk) <- "FibroblastSubtype";


Idents(CellsChunk) <- "seurat_clusters";
txtfileAssi <- paste(mydirX, "/AssignedSubclusters_res", res, ".", ctype, ".txt", sep="");
write.table(txtfileAssi, x=as.matrix(Idents(CellsChunk)), quote=F, append=F, col.names=F, sep="\t");

Idents(CellsChunk) <- "FibroblastSubtype";
txtfileAssi <- paste(mydirX, "/AssignedSubtypes.", ctype, ".txt", sep="");
write.table(txtfileAssi, x=as.matrix(Idents(CellsChunk)), quote=F, append=F, col.names=F, sep="\t");

genes <- c("Pdgfra","Mfap5",                                                # generic fib
           "Cxcl14","Cdh11","Wt1","Rgs2","Smoc2","Wnt4","Aldh1a2","Bmp7",   # fib F2
           "Clec3b","Col14a1","Fap","Cd55","Cxcl16","Mmp3","Efemp1","Vit",  # fib F3
           "Hells","Ung","Top2a","Aurkb","Ccnb2","Cdc20","Cenpf");          # cell cycle: 2 S, 2 G2>M, 3 M>G2
pngfileDot <- paste(mydirI, "/DotPlot-FibMarkersDev-FibroblastSubtypes.png", sep="");
png(pngfileDot, h=800, w=1800, res=200);
DotPlot(CellsChunk, features=genes) + RotatedAxis() + scale_color_viridis(option="D") + theme(axis.text.x=element_text(angle=90, vjust=0.5, hjust=1)) + ylab('') + xlab('');
dev.off();

pngfileUMAP <- paste(mydirI, "/UMAP-AssignedSubtypes.", ctype, ".png", sep="");
png(pngfileUMAP, h=800, w=750, res=200);
DimPlot(CellsChunk, group.by="ident", pt.size=0.2, reduction='umap', shuffle=TRUE, label=T,
        cols=c("FibroblastF2"="gold", "FibroblastF3"="dodgerblue", "FibroblastUnk"="forestgreen", "ProliferatingFibroblastSG2"="lightpink", "ProliferatingFibroblastM"="hotpink"))+
        NoLegend();
dev.off();


### Pull subtype markers.
txtfile1 <- paste(mydirX, "/Marks-Subtypes.", ctype, ".all.txt", sep="");
txtfile2 <- paste(mydirX, "/Marks-Subtypes.", ctype, ".adjp_0.01.txt", sep="");
txtfile3 <- paste(mydirX, "/Marks-Subtypes.", ctype, ".Top5-seurat_filter.txt", sep="");
marksTmp <- FindAllMarkers(CellsChunk, assay="RNA", only.pos=FALSE);  write.table(file=txtfile1, x=as.matrix(marksTmp), quote=F, append=F, col.names=NA, sep="\t");
marksTmpF <- subset(marksTmp, p_val_adj<0.01);  write.table(file=txtfile2, x=as.matrix(marksTmpF), quote=F, append=F, col.names=NA, sep="\t");
marksTmpTop5 <- marksTmpF %>% group_by(cluster) %>% top_n(n=5, wt=avg_log2FC);  write.table(file=txtfile3, x=as.matrix(marksTmpTop5), quote=F, append=F, col.names=NA, sep="\t");



### Clean up images and save.
CellsFibro <- CellsChunk;
rm(CellsChunk,ctype,g,marksTmp,marksTmpF,marksTmpTop5,mydirI,mydirX,p,pngfile,pngfileDot,pngfileUMAP,res,txtfileAssi,txtfile1,txtfile2,txtfile3);
rm(genes,cellcycle.G2.genes,cellcycle.M.genes,cellcycle.G2M.genes,cellcycle.S.genes);
rm(deg,degfile,thisCluster,marksNow,txtfile);
rm(genesB,ctype_label,pngfile1,pngfile2,pngfile3,mm.mitoticExit.genes,genesFig9c);
save.image("save_rdata/RM-Fibroblast.03feb2025.RData");


### Clean up working object and save.
CellsFibro$RNA_snn_res.0.1 <- NULL;
CellsFibro$RNA_snn_res.0.2 <- NULL;
CellsFibro$RNA_snn_res.0.3 <- NULL;
CellsFibro$RNA_snn_res.0.4 <- NULL;
CellsFibro$RNA_snn_res.0.5 <- NULL;
CellsFibro$RNA_snn_res.0.15 <- NULL;
CellsFibro$RNA_snn_res.0.45 <- NULL;
CellsFibro;
#An object of class Seurat 
#26486 features across 18099 samples within 1 assay 
#Active assay: RNA (26486 features, 2000 variable features)
# 3 layers present: data, counts, scale.data
# 3 dimensional reductions calculated: pca, integrated.rpca, umap
saveRDS(CellsFibro, "save_rds/RM-adult_SrfKO-Fibroblast.03feb2025.rds");

