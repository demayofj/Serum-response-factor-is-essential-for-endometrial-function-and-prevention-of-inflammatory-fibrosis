### These subclusters are really matching up to the split between broad clusters 0 & 1, which is unexpected.
### To look into this:
###   a) check DEGs between broad clusters 0 and 1 ... are these biologically meaningful? (will need Ryan's assessment)
###   b) try subclustering only the Ctrl cells ... does that recapitulate the broad clusters?

degfile <- paste(mydirX, "/deg.broadclusters_c1_vs_c0.txt", sep="");
deg <- FindMarkers(CellsChunk, ident.1="1", ident.2="0", group.by="broad_clusters", verbose=TRUE, assay="RNA", only.pos=FALSE, logfc.threshold=0);  # no minimum log2fc
write.table(deg, file=degfile, sep="\t", quote=F, row.names=TRUE, col.names=NA);

ctype_label <- "fibro_Ctrl";
CellsFibWT <- subset(CellsChunk, subset = genotype == "Ctrl");
CellsFibWT[["RNA"]] <- split(CellsFibWT[["RNA"]], f=CellsFibWT$Sample);
Layers(CellsFibWT);
CellsFibWT <- FindVariableFeatures(CellsFibWT);
CellsFibWT <- ScaleData(CellsFibWT, vars.to.regress=c("percent.mt"));  # features=rownames(CellsFibWT));
CellsFibWT <- RunPCA(CellsFibWT, npcs=100);
CellsFibWT <- IntegrateLayers(object=CellsFibWT, method=RPCAIntegration, orig.reduction="pca", new.reduction = "integrated.rpca");
CellsFibWT <- JoinLayers(CellsFibWT);
CellsFibWT <- RunUMAP(CellsFibWT, dims=1:30, reduction = "integrated.rpca");
pngfile1 <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype_label, ".ViewBySample.png", sep="");
pngfile2 <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype_label, ".ViewByPhase.png", sep="");
pngfile3 <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype_label, ".ViewByBroadCluster.png", sep="");
png(pngfile1, h=500, w=570, res=100);
DimPlot(CellsFibWT, group.by="Sample", pt.size=0.5, reduction='umap', shuffle=TRUE);
dev.off();
png(pngfile2, h=500, w=570, res=100);
DimPlot(CellsFibWT, group.by="Phase", pt.size=0.5, reduction='umap', shuffle=TRUE);
dev.off();
