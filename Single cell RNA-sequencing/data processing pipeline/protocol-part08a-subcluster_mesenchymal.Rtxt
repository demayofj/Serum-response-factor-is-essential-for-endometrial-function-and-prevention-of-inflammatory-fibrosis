# R432

### NOTE: Did not use this in the end -- fibroblasts were handled separately from smooth muscle + perivascular.


# Check expression of specific genes of interest.
# See if called subclusters make sense -- especially for fibroblasts.

library(Seurat);         # v5.0.1
library(ggplot2);        # v3.4.4
library(dplyr);
library(viridis);

if (!dir.exists("subcluster")) { dir.create("subcluster") }

load("save_rdata/RM-CellsUse-IntegratedBySample.18jan2025.RData");
ctype <- "mesenchymal";

mydirX <- paste("subcluster/", ctype, sep="");
mydirI <- paste(mydirX, "/images", sep="");
if (!dir.exists(mydirX)) { dir.create(mydirX) }
if (!dir.exists(mydirI)) { dir.create(mydirI) }

Idents(CellsUse) <- "seurat_clusters";
CellsChunk <- subset(CellsUse, idents=c(0,1,4,6,7,8,11,14));
CellsChunk$broad_clusters <- CellsChunk$seurat_clusters;  # seurat_clusters will get overwritten later, so give the broad cluster IDs a different name

table(CellsChunk$broad_clusters,CellsChunk$Sample);
#     Ctrl1 Ctrl2 SrfKO1 SrfKO2
#  0   3316  3426   1180   1513
#  1   1101  1369   1069   1415
#  4    664   337    360    375
#  6    332   236    455    599
#  7    551   279    176     73
#  8    375   258    100    276
#  11   268   174    104    351
#  14   356    85      1     32


### Integration by sample.
CellsChunk[["RNA"]] <- split(CellsChunk[["RNA"]], f=CellsChunk$Sample);
Layers(CellsChunk);
CellsChunk <- FindVariableFeatures(CellsChunk);

### don't regress out CC differences (for consistency with other analysis in this project)
CellsChunk <- ScaleData(CellsChunk, vars.to.regress=c("percent.mt"));  # features=rownames(CellsChunk));
CellsChunk <- RunPCA(CellsChunk, npcs=100);
CellsChunk <- IntegrateLayers(object=CellsChunk, method=RPCAIntegration, orig.reduction="pca", new.reduction = "integrated.rpca");
CellsChunk <- JoinLayers(CellsChunk);
CellsChunk <- RunUMAP(CellsChunk, dims=1:30, reduction = "integrated.rpca");
pngfile1 <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype, ".ViewBySample.png", sep="");
pngfile2 <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype, ".ViewByGenotype.png", sep="");
pngfile3 <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype, ".ViewBySampleSplit.png", sep="");
pngfile4 <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype, ".ViewByPhase.png", sep="");
pngfile5 <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype, ".ViewByBroadCluster.png", sep="");
png(pngfile1, h=500, w=570, res=100);
DimPlot(CellsChunk, group.by="Sample", pt.size=0.5, reduction='umap', shuffle=TRUE);
dev.off();
png(pngfile2, h=500, w=570, res=100);
DimPlot(CellsChunk, group.by="genotype", pt.size=0.5, reduction='umap', shuffle=TRUE);
dev.off();
png(pngfile3, h=1000, w=950, res=100);
DimPlot(CellsChunk, group.by="Sample", split.by="Sample", pt.size=0.5, reduction='umap', ncol=2)+NoLegend();
dev.off();
png(pngfile4, h=500, w=570, res=100);
DimPlot(CellsChunk, group.by="Phase", pt.size=0.5, reduction='umap', shuffle=TRUE);
dev.off();
png(pngfile5, h=500, w=570, res=100);
DimPlot(CellsChunk, group.by="broad_clusters", pt.size=0.5, reduction='umap', shuffle=TRUE);
dev.off();

pngfile <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype, ".broad_clusters.png", sep="");  ## better resolution
png(pngfile, h=800, w=800, res=200);
DimPlot(CellsChunk, group.by="broad_clusters", pt.size=0.2, label=T, reduction='umap', shuffle=TRUE)+NoLegend();
dev.off();

txtfile <- paste(mydirX, "/UMAP-RPCA-bySample-noCC.", ctype, ".coordinates.txt", sep="");
write.table(file=txtfile, x=as.matrix(CellsChunk@reductions$umap@cell.embeddings), quote=F, append=F, col.names=F, sep="\t");

rm(CellsUse);

### these are markers from Saunders figure 9c
genesFig9c <- c("Acta2","Myh11","Tagln","Cnn1","Kitl","Pln","Lmod1","Sorbs2",
                "Rgs5","Kcnj8","Myo1b","Abcc9","Ednrb","Vtn","Nrp1","Ifitm1",
                "Spon2","Aspg","Dpep1","Ngfr","Angptl7","Ifit1","Ifit3","H2-Q7",
                "Cxcl14","Cdh11","Wt1","Rgs2","Smoc2","Wnt4","Aldh1a2","Bmp7",
                "Clec3b","Col14a1","Fap","Cd55","Cxcl16","Mmp3","Efemp1","Vit");

### dot plot - Fig9c markers at broad clusters
orderBC <- c(11,14,4,0,1,6,7,8);  # arrange clusters by broad type
CC <- CellsChunk;
Idents(CC) <- factor(Idents(CC), levels=rev(orderBC));
pngfileDot <- paste(mydirI, "/DotPlot-Fig9cMarkers-Mesenchymal.byBroadCluster.png", sep="");
png(pngfileDot, h=800, w=1800, res=200);
DotPlot(CC, features=genesFig9c) + RotatedAxis() + scale_color_viridis(option="D") + theme(axis.text.x=element_text(angle=90, vjust=0.5, hjust=1)) + ylab('') + xlab('');
dev.off();

### features plots - Fig9c markers
for (g in 1:length(genesFig9c)) {
  pngfile <- paste(mydirI, "/UMAP-GOI-Fig9cMarkers.", genesFig9c[g], ".png", sep="");
  if (!file.exists(pngfile)) {
    png(pngfile, h=800, w=900, res=200);
    p <- FeaturePlot(CellsChunk, features=genesFig9c[g], pt.size=0.2);
    print(p);
    dev.off();
  }
}

## Subclustering, all cells.
DefaultAssay(CellsChunk) <- "RNA";
CellsChunk <- FindNeighbors(CellsChunk, reduction='pca', dims=1:25);

res <- 0.1;
CellsChunk <- FindClusters(CellsChunk, resolution=res);
pngfile <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype, ".subcluster-res", res, ".png", sep="");
png(pngfile, h=800, w=800, res=200);
DimPlot(CellsChunk, group.by="ident", pt.size=0.2, label=T, reduction='umap')+NoLegend();
dev.off();
table(CellsChunk$seurat_clusters,CellsChunk$genotype);
#    Ctrl SrfKO
#  0 9333  5258
#  1 1278  1223
#  2 1000   734
#  3  883   488
#  4  633   376
pngfileDot <- paste(mydirI, "/DotPlot-Fig9cMarkers-Mesenchymal.subclusters_res", res, ".png", sep="");
png(pngfileDot, h=800, w=1800, res=200);
DotPlot(CellsChunk, features=genesFig9c) + RotatedAxis() + scale_color_viridis(option="D") + theme(axis.text.x=element_text(angle=90, vjust=0.5, hjust=1)) + ylab('') + xlab('');
dev.off();

res <- 0.2;  ## this almost perfectly recapitulates the broad clusters
CellsChunk <- FindClusters(CellsChunk, resolution=res);
pngfile <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype, ".subcluster-res", res, ".png", sep="");
png(pngfile, h=800, w=800, res=200);
DimPlot(CellsChunk, group.by="ident", pt.size=0.2, label=T, reduction='umap')+NoLegend();
dev.off();
table(CellsChunk$seurat_clusters,CellsChunk$genotype);
#    Ctrl SrfKO
#  0 6858  2530
#  1 2369  2654
#  2 1000   734
#  3  563  1050
#  4  821   247
#  5  633   376
#  6  442   455
#  7  441    33
table(CellsChunk$broad_clusters,CellsChunk$seurat_clusters);
#        0    1    2    3    4    5    6    7
#  0  8786  648    0    1    0    0    0    0
#  1   582 4370    0    2    0    0    0    0
#  4     2    0 1734    0    0    0    0    0
#  6    11    1    0 1610    0    0    0    0
#  7     7    4    0    0 1068    0    0    0
#  8     0    0    0    0    0 1009    0    0
#  11    0    0    0    0    0    0  897    0
#  14    0    0    0    0    0    0    0  474
pngfileDot <- paste(mydirI, "/DotPlot-Fig9cMarkers-Mesenchymal.subclusters_res", res, ".png", sep="");
png(pngfileDot, h=800, w=1800, res=200);
DotPlot(CellsChunk, features=genesFig9c) + RotatedAxis() + scale_color_viridis(option="D") + theme(axis.text.x=element_text(angle=90, vjust=0.5, hjust=1)) + ylab('') + xlab('');
dev.off();

res <- 0.3;
CellsChunk <- FindClusters(CellsChunk, resolution=res);
pngfile <- paste(mydirI, "/UMAP-RPCA-bySample-noCC.", ctype, ".subcluster-res", res, ".png", sep="");
png(pngfile, h=800, w=800, res=200);
DimPlot(CellsChunk, group.by="ident", pt.size=0.2, label=T, reduction='umap')+NoLegend();
dev.off();
table(CellsChunk$seurat_clusters,CellsChunk$genotype);
#    Ctrl SrfKO
#  0 6579  2491
#  1 2632  2687
#  2  568  1053
#  3  891   606
#  4  831   249
#  5  633   376
#  6  442   455
#  7  441    33
#  8  110   129
pngfileDot <- paste(mydirI, "/DotPlot-Fig9cMarkers-Mesenchymal.subclusters_res", res, ".png", sep="");
png(pngfileDot, h=800, w=1800, res=200);
DotPlot(CellsChunk, features=genesFig9c) + RotatedAxis() + scale_color_viridis(option="D") + theme(axis.text.x=element_text(angle=90, vjust=0.5, hjust=1)) + ylab('') + xlab('');
dev.off();


save.image("Working-mesenchymal-31jan2025.RData");

