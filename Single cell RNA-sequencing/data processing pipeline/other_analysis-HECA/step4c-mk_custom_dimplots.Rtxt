library(ggplot2);
library(dplyr);

infile <- "info_for_umap_views.03mar2025.txt";
data  <- read.delim(infile, header=TRUE);
set.seed(77); rr <- sample(nrow(data)); ddAll <- data[rr,];  # shuffle rows for better mixing of colors
x1 <- floor(min(data$umapX));
x2 <- ceiling(max(data$umapX));
y1 <- floor(min(data$umapY));
y2 <- ceiling(max(data$umapY));

ddH <- subset(ddAll, (ddAll$species == "human"));
### plot human with assigned cell type
png("UMAP.hecaNH-AssignedCellType.png", h=1200, w=1150, res=300);
mainlab <- "HECA(NH) -- assigned cell type";
median_data <- ddH %>% group_by(humanCellType) %>% summarise(median_x = median(umapX), median_y = median(umapY));
ggplot(ddH, aes(x=umapX, y=umapY, color=colorHuman)) + ggtitle(mainlab) + geom_point(size=0.1) + theme_classic() + xlab("UMAP_1") + ylab("UMAP_2") + 
       coord_cartesian(xlim=c(x1,x2),ylim=c(y1,y2)) + scale_colour_identity() +
       annotate("text", x=median_data$median_x, y=median_data$median_y, label=median_data$humanCellType, size=2);
dev.off();
png("UMAP.hecaNH-AssignedCellType.NoLabels.png", h=1200, w=1150, res=300);
mainlab <- "HECA(NH) -- assigned cell type";
median_data <- ddH %>% group_by(humanCellType) %>% summarise(median_x = median(umapX), median_y = median(umapY));
ggplot(ddH, aes(x=umapX, y=umapY, color=colorHuman)) + ggtitle(mainlab) + geom_point(size=0.1) + theme_classic() + xlab("UMAP_1") + ylab("UMAP_2") +
       coord_cartesian(xlim=c(x1,x2),ylim=c(y1,y2)) + scale_colour_identity();
dev.off();

ddM <- subset(ddAll, (ddAll$species == "mouse"));
ddMWT <- subset(ddM, (ddM$genotype == "Ctrl"));
ddMKO <- subset(ddM, (ddM$genotype == "SrfKO"));
### plot mouse with assigned cell type
png("UMAP.mouse_all-AssignedCellType.png", h=1200, w=1150, res=300);
mainlab <- "Adult Ctrl+SrfKO -- assigned cell type";
median_data <- ddM %>% group_by(mouseCellType) %>% summarise(median_x = median(umapX), median_y = median(umapY));
ggplot(ddM, aes(x=umapX, y=umapY, color=colorMouse)) + ggtitle(mainlab) + geom_point(size=0.1) + theme_classic() + xlab("UMAP_1") + ylab("UMAP_2") +
       coord_cartesian(xlim=c(x1,x2),ylim=c(y1,y2)) + scale_colour_identity() +
       annotate("text", x=median_data$median_x, y=median_data$median_y, label=median_data$mouseCellType, size=2);
dev.off();
png("UMAP.mouse_Ctrl-AssignedCellType.png", h=1200, w=1150, res=300);
mainlab <- "Adult Ctrl -- assigned cell type";
median_data <- ddMWT %>% group_by(mouseCellType) %>% summarise(median_x = median(umapX), median_y = median(umapY));
ggplot(ddMWT, aes(x=umapX, y=umapY, color=colorMouse)) + ggtitle(mainlab) + geom_point(size=0.1) + theme_classic() + xlab("UMAP_1") + ylab("UMAP_2") +
       coord_cartesian(xlim=c(x1,x2),ylim=c(y1,y2)) + scale_colour_identity() +
       annotate("text", x=median_data$median_x, y=median_data$median_y, label=median_data$mouseCellType, size=2);
dev.off();
png("UMAP.mouse_SrfKO-AssignedCellType.png", h=1200, w=1150, res=300);
mainlab <- "Adult SrfKO -- assigned cell type";
median_data <- ddMKO %>% group_by(mouseCellType) %>% summarise(median_x = median(umapX), median_y = median(umapY));
ggplot(ddMKO, aes(x=umapX, y=umapY, color=colorMouse)) + ggtitle(mainlab) + geom_point(size=0.1) + theme_classic() + xlab("UMAP_1") + ylab("UMAP_2") +
       coord_cartesian(xlim=c(x1,x2),ylim=c(y1,y2)) + scale_colour_identity() +
       annotate("text", x=median_data$median_x, y=median_data$median_y, label=median_data$mouseCellType, size=2);
dev.off();
### plot mouse with transferred/predicted cell type
png("UMAP.mouse_all-PredictedCellType.png", h=1200, w=1150, res=300);
mainlab <- "Adult Ctrl+SrfKO -- transferred cell type";
median_data <- ddM %>% group_by(humanCellType) %>% summarise(median_x = median(umapX), median_y = median(umapY));
ggplot(ddM, aes(x=umapX, y=umapY, color=colorHuman)) + ggtitle(mainlab) + geom_point(size=0.1) + theme_classic() + xlab("UMAP_1") + ylab("UMAP_2") +
       coord_cartesian(xlim=c(x1,x2),ylim=c(y1,y2)) + scale_colour_identity() +
       annotate("text", x=median_data$median_x, y=median_data$median_y, label=median_data$humanCellType, size=2);
dev.off();
png("UMAP.mouse_Ctrl-PredictedCellType.png", h=1200, w=1150, res=300);
mainlab <- "Adult Ctrl -- transferred cell type";
median_data <- ddMWT %>% group_by(humanCellType) %>% summarise(median_x = median(umapX), median_y = median(umapY));
ggplot(ddMWT, aes(x=umapX, y=umapY, color=colorHuman)) + ggtitle(mainlab) + geom_point(size=0.1) + theme_classic() + xlab("UMAP_1") + ylab("UMAP_2") +
       coord_cartesian(xlim=c(x1,x2),ylim=c(y1,y2)) + scale_colour_identity() +
       annotate("text", x=median_data$median_x, y=median_data$median_y, label=median_data$humanCellType, size=2);
dev.off();
png("UMAP.mouse_SrfKO-PredictedCellType.png", h=1200, w=1150, res=300);
mainlab <- "Adult SrfKO -- transferred cell type";
median_data <- ddMKO %>% group_by(humanCellType) %>% summarise(median_x = median(umapX), median_y = median(umapY));
ggplot(ddMKO, aes(x=umapX, y=umapY, color=colorHuman)) + ggtitle(mainlab) + geom_point(size=0.1) + theme_classic() + xlab("UMAP_1") + ylab("UMAP_2") +
       coord_cartesian(xlim=c(x1,x2),ylim=c(y1,y2)) + scale_colour_identity() +
       annotate("text", x=median_data$median_x, y=median_data$median_y, label=median_data$humanCellType, size=2);
dev.off();

### for selected mouse cell types, plot cells with color according to transferred/predicted cell type; layer these over background of 'snow' human cells; split by genotype
ddHH <- ddH; ddHH$colorHuman <- "snow";
# fibro F2
ddXWT <- subset(ddMWT, (ddMWT$mouseCellType == "FibroblastF2"));
ddXKO <- subset(ddMKO, (ddMKO$mouseCellType == "FibroblastF2"));
ddCWT <- rbind(ddHH,ddXWT);
ddCKO <- rbind(ddHH,ddXKO);
png("UMAP.mouse_Ctrl-FibroF2-PredictedCellType.png", h=1200, w=1150, res=300);
mainlab <- "Adult Ctrl [FibF2] -- trans. type";
median_data <- ddXWT %>% group_by(humanCellType) %>% summarise(median_x = median(umapX), median_y = median(umapY));
ggplot(ddCWT, aes(x=umapX, y=umapY, color=colorHuman)) + ggtitle(mainlab) + geom_point(size=0.1) + theme_classic() + xlab("UMAP_1") + ylab("UMAP_2") +
       coord_cartesian(xlim=c(x1,x2),ylim=c(y1,y2)) + scale_colour_identity() +
       annotate("text", x=median_data$median_x, y=median_data$median_y, label=median_data$humanCellType, size=2);
dev.off();
png("UMAP.mouse_SrfKO-FibroF2-PredictedCellType.png", h=1200, w=1150, res=300);
mainlab <- "Adult SrfKO [FibF2] -- trans. type";
median_data <- ddXKO %>% group_by(humanCellType) %>% summarise(median_x = median(umapX), median_y = median(umapY));
ggplot(ddCKO, aes(x=umapX, y=umapY, color=colorHuman)) + ggtitle(mainlab) + geom_point(size=0.1) + theme_classic() + xlab("UMAP_1") + ylab("UMAP_2") +
       coord_cartesian(xlim=c(x1,x2),ylim=c(y1,y2)) + scale_colour_identity() +
       annotate("text", x=median_data$median_x, y=median_data$median_y, label=median_data$humanCellType, size=2);
dev.off();
