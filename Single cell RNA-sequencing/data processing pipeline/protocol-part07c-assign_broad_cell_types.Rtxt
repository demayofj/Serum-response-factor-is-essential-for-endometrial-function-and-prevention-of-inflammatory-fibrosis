degfile <- paste(mydirX, "/deg.c14-vs-c11.smooth_muscle.txt", sep="");
deg <- FindMarkers(CellsUse, ident.1="14", ident.2="11", group.by="seurat_clusters", verbose=TRUE, assay="RNA", only.pos=FALSE, logfc.threshold=0);  # no minimum log2fc
write.table(deg, file=degfile, sep="\t", quote=F, row.names=TRUE, col.names=NA);
genesX <- c("Actg2","Cnn1");  # 14/11 common
for (g in 1:length(genesX)) {
