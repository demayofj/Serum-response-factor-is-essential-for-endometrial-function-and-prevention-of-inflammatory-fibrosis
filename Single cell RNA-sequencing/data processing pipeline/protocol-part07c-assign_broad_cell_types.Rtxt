# R432

## Explore the broad cell types.  Check known markers, try SingleR, etc.

library(Seurat);         # v5.0.1
library(ggplot2);        # v3.4.4
library(dplyr);
library(viridis);
library(SingleR);

mydirX <- "broad_clusters";
mydirI <- "broad_clusters/images";
ctype <- "broadAuto";
if (!dir.exists(mydirX)) { dir.create(mydirX) }
if (!dir.exists(mydirI)) { dir.create(mydirI) }

load("save_rdata/RM-CellsUse-IntegratedBySample.18jan2025.RData");

load("/ddn/gs1/home/grimmsa/references/MCA_singlecell/MCA_rawCounts_withAnnotations.RData");
mca_uterus <- subset(mcaDataAll, Tissue == "Uterus");  # all stages
mca_uterus_fetal <- subset(mca_uterus, Stage == "Fetal");
## layer 'data' exists but it looks identical to 'counts', so run NormalizeData on it
mca_uterus <- NormalizeData(mca_uterus);
mca_uterus_fetal <- NormalizeData(mca_uterus_fetal);
sce_ref_uterus <- as.SingleCellExperiment(mca_uterus);
sce_ref_uterus_fetal <- as.SingleCellExperiment(mca_uterus_fetal);
rm(mcaDataAll);

