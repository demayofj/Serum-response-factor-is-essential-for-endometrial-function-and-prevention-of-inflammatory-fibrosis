rm(ctype,mydirI,mydirX,pngfile,txtfile,txtfile1,txtfile2,txtfile3,txtfile,marksTmp,marksTmpF,marksTmpTop5);
save.image("save_rdata/RM-CellsUse-IntegratedBySample-SingleR.19jan2025.RData");



library(celldex);  # for ImmGen references
igImmRef <- celldex::ImmGenData();
SR_immune <- SingleR(test=as.SingleCellExperiment(CellsUse), ref=igImmRef, labels=igImmRef$label.main);
CellsUse$SR_broad_ImmGen <- SR_immune$labels;
table(CellsUse$seurat_clusters,CellsUse$SR_broad_ImmGen);
pngfile <- paste(mydirX, "/UMAP-RPCA-BySample.SingleR_broad_ImmGen.png", sep="");
png(pngfile, h=900, w=1200, res=100);
DimPlot(CellsUse, group.by="SR_broad_ImmGen", pt.size=0.5, label=T, reduction='umap', shuffle=T);
dev.off();
txtfile <- paste(mydirX, "/FromSingleR.broad_ImmGen.txt", sep="");
write.table(txtfile, x=as.matrix(CellsUse$SR_broad_ImmGen), quote=F, append=F, col.names=F, sep="\t");

mydirIkm <- "broad_clusters/known_markers";
if (!dir.exists(mydirIkm)) { dir.create(mydirIkm) }
genesI <- c("C1qa","Lyz2","Cd79a","Ebf1","Iglc2",  # mac,mono,B,B,B
            "Xcr1","Clec9a","Tlr3",   # cDC1
            "Cd209a","Clec10a",   # cDC2
            "Siglech","Ccr9",    # pDC
            "Mreg","Fscn1",   # mregDC
            "Lef1","Tcf7","Dapl1","Icos",  # T
            "Cd3g","Trbc2",   # T and NKT
            "Tbx21","Nkg7",   # NKT and NK
            "Ncr1","Gzma",   # NK
            "Gata3","Il1rl1",  # ILC2, ILC2/baso
            "S100a9","S100a8","Il1r2",  # neutrophil
            "Cpa3","Ms4a2","Gata2");   # basophil
for (g in 1:length(genesI)) {
  pngfile <- paste(mydirIkm, "/UMAP-GOI-ImmuneMarkers.", genesI[g], ".png", sep="");
  if (!file.exists(pngfile)) {
    png(pngfile, h=800, w=900, res=200);
    p <- FeaturePlot(CellsUse, features=genesI[g], pt.size=0.2);
    print(p);
    dev.off();
  }
}

