## suggests split between immune and endothelial (although from later info, really over-calls endothelial) but otherwise not much help
SR_ctype_fetal <- SingleR(test=as.SingleCellExperiment(CellsUse), ref=sce_ref_uterus_fetal, labels=sce_ref_uterus_fetal$CellType);
CellsUse$SR_CTypeFetal <- SR_ctype_fetal$labels;
table(CellsUse$seurat_clusters,CellsUse$SR_CTypeFetal);
pngfile <- paste(mydirX, "/UMAP-RPCA-BySample.SingleR_CellType_FetalUterus.png", sep="");
png(pngfile, h=900, w=1200, res=100);
DimPlot(CellsUse, group.by="SR_CTypeFetal", pt.size=0.5, label=T, reduction='umap', shuffle=T);
dev.off();
