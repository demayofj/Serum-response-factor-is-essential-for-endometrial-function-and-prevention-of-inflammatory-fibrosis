### Dot plot with selected marker genes -- dev version.
genes <- c("Pdgfra","Mfap5","Cenpf","Diaph3","Flt1","Pecam1","Prox1","Sema3d","Rgs5","Pdgfrb","Actg2","Cnn1","Msln","Upk3b",
           "Clec3b","Adh1","Prss23","Cdh1","Epcam","C1qa","Ms4a7","Wdfy4","Cd209a","Siglech","Ccr9","Gzma","Nkg7","Trbc2","Icos",
           "S100a8","Il1r2","Iglc2","Cd79a");
orderST <- c(0,1,6,7,2,19,4,11,14,18,8,3,9,5,13,17,10,15,12,16);
CC <- CellsUse;
Idents(CC) <- factor(Idents(CC), levels=rev(orderST));

pngfile <- paste(mydirX, "/DotPlot-KnownMarkers-AssignedCellTypes-draft_20jan2025.png", sep="");
png(pngfile, h=1400, w=2000, res=200);
DotPlot(CC, features=genes) + RotatedAxis() + scale_color_viridis(option="D") + theme(axis.text.x=element_text(angle=90, vjust=0.5, hjust=1)) + ylab('') + xlab('');
dev.off();



Idents(CellsUse) <- "genotype";
pngfile <- paste(mydirX, "/FeaturePlot-Srf-byGenotype.png", sep="");
png(pngfile, h=900, w=1600, res=200);
FeaturePlot(CellsUse, features=c("Srf"), pt.size=0.2, max.cutoff=1.5)+facet_wrap('ident',ncol=2);
dev.off();

Idents(CC) <- "seurat_clusters";
Idents(CC) <- factor(Idents(CC), levels=orderST);
pngfile <- paste(mydirX, "/Violin-Srf-byGenotype.png", sep="");
png(pngfile, h=700, w=1800, res=200);
VlnPlot(CC, split.by="genotype", features=c("Srf"), pt.size=0, split.plot=TRUE);
dev.off();
pngfile <- paste(mydirX, "/Violin-Srf-byGenotype.v2.png", sep="");
png(pngfile, h=700, w=1800, res=200);
VlnPlot(CC, split.by="genotype", features=c("Srf"), pt.size=0.01, split.plot=TRUE);
dev.off();

