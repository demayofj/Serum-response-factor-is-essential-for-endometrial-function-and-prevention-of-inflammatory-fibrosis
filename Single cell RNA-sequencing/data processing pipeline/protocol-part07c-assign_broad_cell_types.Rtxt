## this is a mess -- probably not a good idea to use all stages together
SR_ctype_all <- SingleR(test=as.SingleCellExperiment(CellsUse), ref=sce_ref_uterus, labels=sce_ref_uterus$CellType);
CellsUse$SR_CTypeAll <- SR_ctype_all$labels;
table(CellsUse$seurat_clusters,CellsUse$SR_CTypeAll); 
pngfile <- paste(mydirX, "/UMAP-RPCA-BySample.SingleR_CellType_AllUterus.png", sep="");
png(pngfile, h=900, w=1200, res=100);
DimPlot(CellsUse, group.by="SR_CTypeAll", pt.size=0.5, label=T, reduction='umap', shuffle=T);
dev.off();
txtfile	<- paste(mydirX, "/FromSingleR.CellType_AllUterus.txt", sep="");
write.table(txtfile, x=as.matrix(CellsUse$SR_CTypeAll), quote=F, append=F, col.names=F, sep="\t");

