# R432

## Rename cell types, pull out cells by genotype (just SrfKO here), and run through CellChat processing.
## Skip most visualizations here.

# devtools::install_github("jinworks/CellChat");
# https://github.com/jinworks/CellChat/blob/main/tutorial/CellChat-vignette.Rmd

if (!dir.exists("cellchat_outputs")) { dir.create("cellchat_outputs") }

library(CellChat);
library(patchwork);
options(stringsAsFactors=FALSE);
library(Seurat);
library(NMF);
library(ggalluvial);

## Part I: Setup object and preprocessing.
CellsUse <- readRDS("save_rds/RM-adult_SrfKO-FilteredIntegratedAnnotated.04feb2025.rds");
CellsUse <- RenameIdents(CellsUse, 'LymphaticEndothelial'="EndoLymph", 'Endothelial'="Endothelial", 'GlandularEpithelial'="Epi-Glnd", 'ProliferatingGlandularEpithelial'="Epi-Glnd_Prolif",
                                   'LowQualEpithelial'="Epi-LowQual", 'LuminalEpithelial'="Epi-Luminal", 'FibroblastF2'="Fibro-F2", 'FibroblastF3'="Fibro-F3", 'ProliferatingFibroblastM'="Fibro-ProlifG2M",
                                   'ProliferatingFibroblastSG2'="Fibro-ProlifSG2", 'FibroblastUnk'="Fibro-Unk", 'Bcell'="Imm-Bcell", 'cDC2_mregDC'="Imm-cDC2_mregDC", 'cDC1'="Imm-DC1",
                                   'gammadeltaT'="Imm-gdT", 'ILC2'="Imm-ILC2", 'Macrophage'="Imm-Macrophage", 'Monocyte'="Imm-Monocyte", 'Neutrophil'="Imm-Neutrophil", 'NK'="Imm-NK",
                                   'ProliferatingNK'="Imm-NK_Prolif", 'pDC'="Imm-pDC", 'Plasma'="Imm-Plasma", 'T_NKT'="Imm-T_NKT", 'Mesothelial'="Mesothelial", 'Perivascular'="Perivascular",
                                   'SmoothMuscle'="SmoothMuscle")
CellsUse$ccname <- Idents(CellsUse);
Idents(CellsUse) <- "ccname";
CellsSrfKO <- subset(CellsUse, subset =	genotype == "SrfKO");
table(CellsSrfKO$ccname,CellsSrfKO$Sample);  # spot-check names and filter results
unique(Idents(CellsSrfKO));  # make sure current Idents are the renamed cell types
CellsSrfKO$samples <- CellsSrfKO$Sample;  # the next step assumes 'samples' is in the Seurat object, so put it there
CCobjSrfKO <- createCellChat(object=CellsSrfKO, group.by="ccname");
CellChatDB <- CellChatDB.mouse;
#png("cellchat_outputs/showDbCat_pie_charts.png", h=500, w=800, res=200);
#showDatabaseCategory(CellChatDB);
#dev.off();
#dplyr::glimpse(CellChatDB$interaction);  # this shows initial entries for categories in 'interaction' types
#CellChatDB.use <- subsetDB(CellChatDB, search = "Secreted Signaling");  # if you want you can use a subset, like "Secreted Signaling"
CellChatDB.use <- CellChatDB;
CCobjSrfKO@DB <- CellChatDB.use;
CCobjSrfKO <- subsetData(CCobjSrfKO);
future::plan("multicore", workers=4);
CCobjSrfKO <- identifyOverExpressedGenes(CCobjSrfKO);
CCobjSrfKO <- identifyOverExpressedInteractions(CCobjSrfKO);  # => "The number of highly variable ligand-receptor pairs used for signaling inference is 3012"
rm(CellsUse,CellsSrfKO);
save.image("Working-CellChatDB-19feb2025-SrfKO-x1.RData");  ## DEV


## Part II: Inference of cell-cell communication network.
CCobjSrfKO <- computeCommunProb(CCobjSrfKO, raw.use=TRUE);
CCobjSrfKO <- filterCommunication(CCobjSrfKO, min.cells=10);
df.net.all.SrfKO <- subsetCommunication(CCobjSrfKO);  # Returns data frame of all the inferred cell-cell communications at the level of ligands/receptors. Set slot.name="netP" to access inferred communications at the level of signaling pathways.
#df.net.spec <- subsetCommunication(CCobjSrfKO, sources.use=c("Macrophage","Neutrophil"), targets.use=c("FibroblastF2","FibroblastF3"));  # Returns data frame of inferred cell-cell communications from/to specific cell groups.
#df.net.sig <- subsetCommunication(CCobjSrfKO, signaling=c("TGFb","GDF"));  # Returns data frame of inferred cell-cell communications mediated by user-defined signalling.
CCobjSrfKO <- computeCommunProbPathway(CCobjSrfKO);  # inferred intercellular communication network of each ligand-receptor pair and signaling pathway is stored in 'net' and 'netP' slots, respectively
CCobjSrfKO <- aggregateNet(CCobjSrfKO);
groupSize <- as.numeric(table(CCobjSrfKO@idents));
#png("cellchat_outputs/circle_view.NumberOfInteractions.SrfKO.png", h=1000, w=1000, res=100);
#netVisual_circle(CCobjSrfKO@net$count, vertex.weight=groupSize, weight.scale=T, label.edge= F, title.name="Number of interactions");
#dev.off();
png("cellchat_outputs/circle_view.WeightOfInteractions.SrfKO.png", h=1000, w=1000, res=100);
netVisual_circle(CCobjSrfKO@net$weight, vertex.weight=groupSize, weight.scale=T, label.edge= F, title.name="Interaction weights/strength");
dev.off();
#mat <- CCobjSrfKO@net$weight;
