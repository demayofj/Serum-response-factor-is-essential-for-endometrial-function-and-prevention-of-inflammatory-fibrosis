## Part IV: Systems analysis of cell-cell communication network
CCobjSrfKO <- netAnalysis_computeCentrality(CCobjSrfKO, slot.name="netP");
#png("cellchat_outputs/network_view.NOTCH_all_example.png", h=1000, w=1000, res=100);
#netAnalysis_signalingRole_network(CCobjSrfKO, signaling=pathways.show, width=18, height=4, font.size=10);
#dev.off();
#png("cellchat_outputs/network_scatter_view.all_example.png", h=1000, w=1000, res=100);
#netAnalysis_signalingRole_scatter(CCobjSrfKO);
#dev.off();
#png("cellchat_outputs/network_scatter_view.selected_example.png", h=1000, w=1000, res=100);
#netAnalysis_signalingRole_scatter(CCobjSrfKO, signaling=c("NOTCH","SEMA7","CXCL","GAP"));
#dev.off();
png("cellchat_outputs/network_heatmap_view.SrfKO.png", h=800, w=1200, res=100);
ht1 <- netAnalysis_signalingRole_heatmap(CCobjSrfKO, pattern="outgoing");
ht2 <- netAnalysis_signalingRole_heatmap(CCobjSrfKO, pattern="incoming");
ht1 + ht2;
dev.off();
#png("cellchat_outputs/network_heatmap_view.selected_example.png", h=1000, w=2000, res=100);
#ht1 <- netAnalysis_signalingRole_heatmap(CCobjSrfKO, pattern="outgoing", signaling=c("NOTCH","SEMA7","CXCL","GAP"));
#ht2 <- netAnalysis_signalingRole_heatmap(CCobjSrfKO, pattern="incoming", signaling=c("NOTCH","SEMA7","CXCL","GAP"));
#ht1 + ht2;
#dev.off();
save.image("Working-CellChatDB-19feb2025-SrfKO-x3.RData");  ## DEV

png("cellchat_outputs/infer_number_of_patterns-outgoing.SrfKO.png", h=500, w=800, res=100);  # choose N at which values (suddenly) drop
selectK(CCobjSrfKO, pattern="outgoing");
dev.off();
nPatternsOut <- 3;  ## define based on plots!
png("cellchat_outputs/comm_patterns-outgoing.SrfKO.png", h=1000, w=1000, res=100);
CCobjSrfKO <- identifyCommunicationPatterns(CCobjSrfKO, pattern="outgoing", k=nPatternsOut);
dev.off();
png("cellchat_outputs/comm_patterns_river-outgoing.SrfKO.png", h=1000, w=1000, res=100);
netAnalysis_river(CCobjSrfKO, pattern="outgoing");
dev.off();
png("cellchat_outputs/comm_patterns_dot-outgoing.SrfKO.png", h=1000, w=2000, res=100);
netAnalysis_dot(CCobjSrfKO, pattern="outgoing");
dev.off();
png("cellchat_outputs/infer_number_of_patterns-incoming.SrfKO.png", h=500, w=800, res=100);  # choose N at which values (suddenly) drop
selectK(CCobjSrfKO, pattern="incoming");
dev.off();
nPatternsIn <- 3;  ## define based on plots!
png("cellchat_outputs/comm_patterns-incoming.SrfKO.png", h=1000, w=1000, res=100);
CCobjSrfKO <- identifyCommunicationPatterns(CCobjSrfKO, pattern="incoming", k=nPatternsIn);
dev.off();
png("cellchat_outputs/comm_patterns_river-incoming_SrfKO.png", h=1000, w=1000, res=100);
netAnalysis_river(CCobjSrfKO, pattern="incoming");
dev.off();
png("cellchat_outputs/comm_patterns_dot-incoming_SrfKO.png", h=1000, w=2000, res=100);
netAnalysis_dot(CCobjSrfKO, pattern="incoming");
dev.off();
save.image("Working-CellChatDB-19feb2025-SrfKO-x4.RData");  ## DEV

CCobjSrfKO <- computeNetSimilarity(CCobjSrfKO, type="functional");
CCobjSrfKO <- netEmbedding(CCobjSrfKO, type="functional", umap.method="uwot");
CCobjSrfKO <- netClustering(CCobjSrfKO, type="functional");
png("cellchat_outputs/comm_patterns_typeFunctional.SrfKO.png", h=1000, w=1000, res=100);
netVisual_embedding(CCobjSrfKO, type="functional", label.size=3.5);
dev.off();
png("cellchat_outputs/comm_patterns_typeFunctional-zoom.SrfKO.png", h=1000, w=1000, res=100);
netVisual_embeddingZoomIn(CCobjSrfKO, type="functional", nCol=2);
dev.off();
CCobjSrfKO <- computeNetSimilarity(CCobjSrfKO, type="structural");
CCobjSrfKO <- netEmbedding(CCobjSrfKO, type="structural", umap.method="uwot");
CCobjSrfKO <- netClustering(CCobjSrfKO, type="structural");
png("cellchat_outputs/comm_patterns_typeStructural.SrfKO.png", h=1000, w=1000, res=100);
netVisual_embedding(CCobjSrfKO, type="structural", label.size=3.5);
dev.off()
png("cellchat_outputs/comm_patterns_typeStructural-zoom.SrfKO.png", h=1000, w=1000, res=100);
netVisual_embeddingZoomIn(CCobjSrfKO, type="structural", nCol=2);
dev.off();


## cleanup and save working object
rm(nPatternsIn,nPatternsOut,CellChatDB,CellChatDB.use,groupSize,ht1,ht2);
save.image("save_rdata/RM-CellChatDB-SrfKO.19feb2025.RData");

